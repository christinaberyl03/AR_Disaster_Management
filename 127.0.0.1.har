            "size": 7717,
            "mimeType": "text/css",
            "text": "/* ==========================================================================\n   DisasterGuard - Command Center Dashboard & App Layouts\n   Fully Responsive for Light Mode (Default) and Dark Mode\n   ========================================================================== */\n\n.app-container {\n  display: flex;\n  min-height: 100vh;\n}\n\n/* Sidebar */\n.app-sidebar {\n  width: var(--sidebar-width);\n  background: var(--bg-sidebar);\n  border-right: 1px solid var(--border-subtle);\n  display: flex;\n  flex-direction: column;\n  position: fixed;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  z-index: 1040;\n  transition: transform var(--transition-smooth), background-color var(--transition-smooth);\n}\n\n.sidebar-brand {\n  height: var(--topbar-height);\n  padding: 0 1.5rem;\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  border-bottom: 1px solid var(--border-subtle);\n  background: var(--bg-sidebar);\n}\n\n.brand-icon {\n  width: 42px;\n  height: 42px;\n  background: linear-gradient(135deg, #2563eb, #1d4ed8);\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: white;\n  font-size: 1.35rem;\n  box-shadow: 0 0 15px rgba(37, 99, 235, 0.35);\n}\n\n.brand-text h1 {\n  font-size: 1.2rem;\n  font-weight: 800;\n  color: var(--text-primary);\n  letter-spacing: -0.01em;\n  margin: 0;\n  line-height: 1.2;\n}\n\n.brand-text span {\n  font-size: 0.65rem;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: var(--safe-emerald);\n  font-weight: 700;\n  font-family: var(--font-mono);\n}\n\n.sidebar-nav {\n  padding: 1.25rem 0.85rem;\n  flex: 1;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.nav-section-title {\n  font-size: 0.68rem;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: var(--text-muted);\n  font-weight: 700;\n  padding: 0.75rem 0.75rem 0.35rem;\n  font-family: var(--font-mono);\n}\n\n.nav-item-link {\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  padding: 0.7rem 0.85rem;\n  color: var(--text-secondary);\n  border-radius: var(--radius-sm);\n  font-weight: 500;\n  font-size: 0.92rem;\n  transition: all var(--transition-fast);\n}\n\n.nav-item-link i {\n  font-size: 1.15rem;\n  width: 22px;\n  text-align: center;\n}\n\n.nav-item-link:hover {\n  background: rgba(37, 99, 235, 0.08);\n  color: var(--info-blue);\n}\n\n.nav-item-link.active {\n  background: rgba(37, 99, 235, 0.12);\n  color: var(--info-blue);\n  border-left: 3px solid var(--info-blue);\n  font-weight: 600;\n}\n\n.sidebar-footer {\n  padding: 1rem;\n  border-top: 1px solid var(--border-subtle);\n  background: var(--bg-sidebar);\n}\n\n.user-profile-chip {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.5rem;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: background var(--transition-fast);\n}\n\n.user-profile-chip:hover {\n  background: rgba(0, 0, 0, 0.04);\n}\n\n[data-theme=\"dark\"] .user-profile-chip:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.user-avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #3b82f6, #8b5cf6);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: white;\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n/* Main Content Wrapper */\n.app-main {\n  margin-left: var(--sidebar-width);\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\n/* Topbar */\n.app-topbar {\n  height: var(--topbar-height);\n  background: var(--bg-topbar);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border-bottom: 1px solid var(--border-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 2rem;\n  position: sticky;\n  top: 0;\n  z-index: 1030;\n}\n\n/* Emergency Alert Ticker */\n.emergency-ticker {\n  flex: 1;\n  max-width: 600px;\n  margin: 0 1.5rem;\n  background: var(--critical-bg);\n  border: 1px solid var(--critical-border);\n  border-radius: 9999px;\n  padding: 0.35rem 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  font-size: 0.82rem;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n.ticker-label {\n  background: var(--critical-red);\n  color: white;\n  padding: 0.15rem 0.5rem;\n  border-radius: 9999px;\n  font-size: 0.7rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  font-family: var(--font-mono);\n}\n\n.ticker-content {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  color: var(--critical-red);\n  font-weight: 600;\n}\n\n/* Page Content */\n.page-content {\n  padding: 2rem;\n  flex: 1;\n}\n\n.page-header {\n  margin-bottom: 1.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.page-title {\n  font-size: 1.75rem;\n  font-weight: 800;\n  color: var(--text-primary);\n}\n\n.page-subtitle {\n  color: var(--text-secondary);\n  font-size: 0.95rem;\n  margin-top: 0.25rem;\n}\n\n/* KPI Metric Cards Grid */\n.kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 1.25rem;\n  margin-bottom: 2rem;\n}\n\n.kpi-card {\n  background: var(--bg-card);\n  backdrop-filter: blur(12px);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  padding: 1.25rem 1.5rem;\n  display: flex;\n  align-items: center;\n  gap: 1.25rem;\n  box-shadow: var(--card-shadow);\n  transition: all var(--transition-fast);\n}\n\n.kpi-card:hover {\n  transform: translateY(-2px);\n  border-color: rgba(37, 99, 235, 0.35);\n  box-shadow: var(--card-shadow-hover);\n}\n\n.kpi-icon-box {\n  width: 52px;\n  height: 52px;\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.6rem;\n}\n\n.kpi-icon-box.red { background: var(--critical-bg); color: var(--critical-red); border: 1px solid var(--critical-border); }\n.kpi-icon-box.emerald { background: var(--safe-bg); color: var(--safe-emerald); border: 1px solid var(--safe-border); }\n.kpi-icon-box.blue { background: var(--info-bg); color: var(--info-blue); border: 1px solid var(--info-border); }\n.kpi-icon-box.amber { background: var(--warning-bg); color: var(--warning-amber); border: 1px solid var(--warning-border); }\n\n.kpi-value {\n  font-size: 1.85rem;\n  font-weight: 800;\n  line-height: 1.1;\n  font-family: var(--font-heading);\n  color: var(--text-primary);\n}\n\n.kpi-title {\n  font-size: 0.82rem;\n  color: var(--text-secondary);\n  font-weight: 500;\n}\n\n/* Live Map Containers */\n#map-container, #mini-map {\n  width: 100%;\n  height: 520px;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-subtle);\n  overflow: hidden;\n  z-index: 1;\n}\n\n#mini-map {\n  height: 380px;\n}\n\n/* Active Position Telemetry Banner */\n.active-pos-banner {\n  background: linear-gradient(135deg, #ffffff, #eff6ff);\n  border: 1px solid #bfdbfe;\n  border-left: 4px solid var(--info-blue);\n  box-shadow: var(--card-shadow);\n}\n\n[data-theme=\"dark\"] .active-pos-banner {\n  background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.7));\n  border: 1px solid var(--border-subtle);\n  border-left: 4px solid var(--info-blue);\n}\n\n.bg-inset-card {\n  background: #f8fafc;\n  border: 1px solid var(--border-subtle);\n}\n\n[data-theme=\"dark\"] .bg-inset-card {\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid var(--border-subtle);\n}\n\n/* Floating Map Controls */\n.map-control-floating {\n  position: absolute;\n  top: 24px;\n  right: 24px;\n  z-index: 1000;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  padding: 1rem 1.25rem;\n  min-width: 260px;\n  box-shadow: var(--card-shadow);\n  color: var(--text-primary);\n}\n\n/* Responsive adjustments */\n@media (max-width: 992px) {\n  .app-sidebar {\n    transform: translateX(-100%);\n  }\n  .app-sidebar.show {\n    transform: translateX(0);\n  }\n  .app-main {\n    margin-left: 0;\n  }\n}\n"
