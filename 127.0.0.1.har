          ],
          "cookies": [],
          "content": {
            "size": 27021,
            "mimeType": "text/javascript",
            "text": "/**\n * DisasterGuard Hazard-Aware Evacuation Navigator\n * End-to-End Navigation Integration:\n * Browser GPS -> Safe Shelter API -> OSRM Road Route -> Leaflet Route Line -> Live Evacuation Map\n */\n\n// Single Navigation State\nconst navigationState = {\n  userLocation: null,      // { lat: number, lon: number }\n  selectedShelter: null,   // Shelter object\n  allShelters: [],         // Array of safe zones\n  allDisasters: [],        // Array of active disasters\n  route: null,             // OSRM route object (data.routes[0])\n  userMarker: null,        // L.marker for current user\n  shelterMarkers: [],      // Array of L.marker for safe zones\n  disasterLayers: [],      // Array of L.circle & L.marker for hazards\n  routeLayer: null         // L.geoJSON for road route\n};\n\nlet navMap = null;\n\ndocument.addEventListener(\"DOMContentLoaded\", async () => {\n  initNavMap();\n  await loadSheltersData();\n  await loadDisastersData();\n\n  // Wire UI event listeners\n  document.getElementById(\"btnUseCurrentLocation\")?.addEventListener(\"click\", () => {\n    fetchUserLocation(true);\n  });\n\n  document.getElementById(\"btnCalculateRoute\")?.addEventListener(\"click\", () => {\n    calculateEvacuationRoute();\n  });\n\n  document.getElementById(\"btnRecalculateRoute\")?.addEventListener(\"click\", () => {\n    recalculateRoute();\n  });\n\n  document.getElementById(\"btnEmergencyNearest\")?.addEventListener(\"click\", () => {\n    triggerNearestShelterSOS();\n  });\n\n  document.getElementById(\"selectSafeZone\")?.addEventListener(\"change\", (e) => {\n    onShelterDropdownChange(e.target.value);\n  });\n\n  // Handle URL query parameters (e.g. ?safe_zone_id=2 or ?origin_lat=... or ?action=emergency)\n  const urlParams = new URLSearchParams(window.location.search);\n  const qLat = parseFloat(urlParams.get(\"origin_lat\"));\n  const qLon = parseFloat(urlParams.get(\"origin_lon\"));\n  const qSafeZoneId = urlParams.get(\"safe_zone_id\");\n  const qAction = urlParams.get(\"action\");\n\n  if (!isNaN(qLat) && !isNaN(qLon)) {\n    setUserLocation(qLat, qLon, true);\n  } else {\n    // Initial auto-detection of location\n    fetchUserLocation(true);\n  }\n\n  if (qSafeZoneId) {\n    setTimeout(() => {\n      selectShelterById(parseInt(qSafeZoneId), true);\n    }, 400);\n  } else if (qAction === \"emergency\") {\n    setTimeout(() => {\n      triggerNearestShelterSOS();\n    }, 500);\n  }\n});\n\n/**\n * 1. Initialize Leaflet Map with OpenStreetMap Standard Base Layer\n * NO CARTO or API-key-dependent tiles!\n */\nfunction initNavMap() {\n  const defaultLat = 13.6300;\n  const defaultLon = 79.4200;\n\n  navMap = L.map(\"navMap\", {\n    zoomControl: true,\n    attributionControl: true\n  }).setView([defaultLat, defaultLon], 14);\n\n  // Pure OpenStreetMap Standard Tiles (No API key required!)\n  L.tileLayer(\"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\", {\n    maxZoom: 19,\n    attribution: '&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors'\n  }).addTo(navMap);\n\n  // Set default state location\n  navigationState.userLocation = { lat: defaultLat, lon: defaultLon };\n  renderUserMarker(defaultLat, defaultLon);\n\n  // Allow clicking on map to set custom departure point\n  navMap.on(\"click\", (e) => {\n    setUserLocation(e.latlng.lat, e.latlng.lng, false);\n    showToast(`Departure location updated to clicked pin (${e.latlng.lat.toFixed(4)}, ${e.latlng.lng.toFixed(4)})`, \"info\");\n  });\n}\n\n/**\n * 2. Get User Location using Browser Geolocation API\n */\nfunction fetchUserLocation(centerMap = true) {\n  if (!(\"geolocation\" in navigator)) {\n    showToast(\"Geolocation is not supported by your browser. Using manual coordinates.\", \"warning\");\n    return;\n  }\n\n  showToast(\"Locating your current GPS coordinates...\", \"info\");\n\n  navigator.geolocation.getCurrentPosition(\n    (pos) => {\n      const lat = pos.coords.latitude;\n      const lon = pos.coords.longitude;\n      setUserLocation(lat, lon, centerMap);\n      showToast(`Location acquired: ${lat.toFixed(4)}, ${lon.toFixed(4)}`, \"success\");\n      \n      // Update nearest shelter suggestions list\n      updateNearestSheltersList();\n    },\n    (err) => {\n      console.warn(\"Geolocation warning:\", err.message);\n      showToast(\"Unable to acquire live GPS. Retaining manual coordinates.\", \"warning\");\n      const curLat = parseFloat(document.getElementById(\"startLat\")?.value || 13.6300);\n      const curLon = parseFloat(document.getElementById(\"startLon\")?.value || 79.4200);\n      setUserLocation(curLat, curLon, centerMap);\n    },\n    { enableHighAccuracy: true, timeout: 8000 }\n  );\n}\n\n/**\n * Set and Render User Location\n */\nfunction setUserLocation(lat, lon, centerMap = false) {\n  navigationState.userLocation = { lat, lon };\n\n  const latInput = document.getElementById(\"startLat\");\n  const lonInput = document.getElementById(\"startLon\");\n  if (latInput) latInput.value = lat.toFixed(6);\n  if (lonInput) lonInput.value = lon.toFixed(6);\n\n  renderUserMarker(lat, lon);\n\n  if (centerMap && navMap) {\n    navMap.setView([lat, lon], 14);\n  }\n}\n\n/**\n * Render Blue \"CURRENT LOCATION\" Marker on Leaflet Map\n */\nfunction renderUserMarker(lat, lon) {\n  if (!navMap) return;\n\n  if (navigationState.userMarker) {\n    navMap.removeLayer(navigationState.userMarker);\n  }\n\n  const userIcon = L.divIcon({\n    html: `\n      <div style=\"position:relative; width:30px; height:30px;\">\n        <div style=\"position:absolute; width:30px; height:30px; border-radius:50%; background:#2563eb; opacity:0.6; animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;\"></div>\n        <div style=\"position:absolute; top:3px; left:3px; width:24px; height:24px; border-radius:50%; background:#2563eb; border:3px solid #ffffff; display:flex; align-items:center; justify-content:center; color:white; box-shadow:0 0 14px rgba(37,99,235,0.8); font-size:12px;\">\n          <i class=\"bi bi-person-fill\"></i>\n        </div>\n      </div>\n    `,\n    className: 'dg-user-location-marker',\n    iconSize: [30, 30]\n  });\n\n  navigationState.userMarker = L.marker([lat, lon], {\n    icon: userIcon,\n    zIndexOffset: 1000\n  })\n    .bindPopup(`\n      <div style=\"min-width: 170px;\">\n        <span class=\"badge bg-primary mb-1\">USER LOCATION</span>\n        <h6 class=\"mb-1 text-dark fw-bold\">CURRENT LOCATION</h6>\n        <div class=\"small text-muted font-monospace\">${lat.toFixed(5)}° N, ${lon.toFixed(5)}° E</div>\n      </div>\n    `)\n    .addTo(navMap);\n}\n\n/**\n * 3. Load Safe Zones from Existing Database API\n */\nasync function loadSheltersData() {\n  try {\n    const shelters = await ApiClient.get(\"/safe-zones\");\n    navigationState.allShelters = shelters || [];\n    \n    populateSheltersDropdown(navigationState.allShelters);\n    renderShelterMarkers(navigationState.allShelters);\n    updateNearestSheltersList();\n  } catch (e) {\n    console.error(\"Failed to load shelters:\", e);\n    showToast(\"Could not load safe shelters from database.\", \"danger\");\n  }\n}\n\n/**\n * Populate \"Target Safe Zone Shelter\" Dropdown\n */\nfunction populateSheltersDropdown(shelters) {\n  const select = document.getElementById(\"selectSafeZone\");\n  if (!select) return;\n\n  select.innerHTML = `<option value=\"\">-- Auto-Select Nearest Open Shelter --</option>`;\n\n  shelters.forEach(sz => {\n    const isFull = sz.status === \"FULL\" || (sz.capacity && sz.current_occupancy >= sz.capacity);\n    const freeSlots = Math.max(0, (sz.capacity || 0) - (sz.current_occupancy || 0));\n    \n    select.innerHTML += `\n      <option value=\"${sz.id}\" ${isFull ? 'disabled' : ''}>\n        ${sz.name} (${sz.status} • ${freeSlots} spaces free)\n      </option>\n    `;\n  });\n}\n\n/**\n * Render Green \"SAFE SHELTER\" Markers on Leaflet Map\n */\nfunction renderShelterMarkers(shelters) {\n  if (!navMap) return;\n\n  // Clear existing shelter markers\n  navigationState.shelterMarkers.forEach(m => navMap.removeLayer(m));\n  navigationState.shelterMarkers = [];\n\n  shelters.forEach(sz => {\n    if (!sz.latitude || !sz.longitude) return;\n\n    const isFull = sz.status === \"FULL\" || (sz.capacity && sz.current_occupancy >= sz.capacity);\n    const color = isFull ? \"#64748b\" : \"#059669\";\n    const iconClass = isFull ? \"bi-shield-x\" : \"bi-shield-check\";\n\n    const shelterIcon = L.divIcon({\n      html: `\n        <div style=\"background:${color}; width:28px; height:28px; border-radius:50%; border:3px solid #ffffff; display:flex; align-items:center; justify-content:center; color:white; box-shadow:0 0 12px ${color}; font-size:14px;\">\n          <i class=\"bi ${iconClass}\"></i>\n        </div>\n      `,\n      className: 'dg-shelter-marker',\n      iconSize: [28, 28]\n    });\n\n    const marker = L.marker([sz.latitude, sz.longitude], { icon: shelterIcon })\n      .bindPopup(`\n        <div style=\"min-width: 220px;\">\n          <div class=\"d-flex align-items-center justify-content-between mb-1\">\n            <span class=\"badge ${isFull ? 'bg-secondary' : 'bg-success'}\">SAFE SHELTER (${sz.status})</span>\n            <small class=\"text-muted\"><i class=\"bi bi-people\"></i> ${sz.current_occupancy || 0}/${sz.capacity || 0}</small>\n          </div>\n          <h6 class=\"mb-1 fw-bold text-dark\">${sz.name}</h6>\n          <p class=\"text-muted small mb-2\">${sz.description || sz.address || 'Designated disaster evacuation shelter.'}</p>\n          ${sz.contact_number ? `<div class=\"small mb-2 text-primary\"><i class=\"bi bi-telephone\"></i> ${sz.contact_number}</div>` : ''}\n          <button class=\"btn btn-sm btn-success w-100 py-1 text-white ${isFull ? 'disabled' : ''}\" onclick=\"selectShelterById(${sz.id}, true)\">\n            <i class=\"bi bi-sign-turn-right-fill\"></i> Route Here\n          </button>\n        </div>\n      `)\n      .addTo(navMap);\n\n    marker.shelterId = sz.id;\n    navigationState.shelterMarkers.push(marker);\n  });\n}\n\n/**\n * 4. Load and Display Active Disasters with Danger Radii\n */\nasync function loadDisastersData() {\n  try {\n    const disasters = await ApiClient.get(\"/disasters\", { status: \"ACTIVE\" });\n    navigationState.allDisasters = disasters || [];\n\n    // Clear existing disaster layers\n    navigationState.disasterLayers.forEach(l => navMap.removeLayer(l));\n    navigationState.disasterLayers = [];\n\n    navigationState.allDisasters.forEach(d => {\n      if (!d.latitude || !d.longitude) return;\n\n      const isCrit = d.severity === \"CRITICAL\";\n      const isHigh = d.severity === \"HIGH\";\n      const color = isCrit ? \"#dc2626\" : isHigh ? \"#d97706\" : \"#f59e0b\";\n      const radius = isCrit ? 1800 : isHigh ? 1200 : 700;\n\n      // Exclusion buffer circle\n      const circle = L.circle([d.latitude, d.longitude], {\n        color: color,\n        fillColor: color,\n        fillOpacity: 0.22,\n        weight: 2,\n        radius: radius\n      }).addTo(navMap);\n\n      const hazardIcon = L.divIcon({\n        html: `\n          <div style=\"background:${color}; width:24px; height:24px; border-radius:50%; border:2px solid white; display:flex; align-items:center; justify-content:center; color:white; font-size:12px; box-shadow:0 0 10px ${color};\">\n            <i class=\"bi bi-exclamation-triangle-fill\"></i>\n          </div>\n        `,\n        className: 'dg-hazard-marker',\n        iconSize: [24, 24]\n      });\n\n      const marker = L.marker([d.latitude, d.longitude], { icon: hazardIcon })\n        .bindPopup(`\n          <div style=\"min-width: 180px;\">\n            <span class=\"badge bg-danger\">${d.severity} HAZARD</span>\n            <h6 class=\"mb-1 text-danger fw-bold\">${d.title}</h6>\n            <div class=\"small text-muted\">${d.description || 'Active exclusion zone.'}</div>\n          </div>\n        `)\n        .addTo(navMap);\n\n      navigationState.disasterLayers.push(circle, marker);\n    });\n  } catch (e) {\n    console.warn(\"Could not load disasters for navigator map:\", e);\n  }\n}\n\n/**\n * 5. Handle Shelter Dropdown Change\n */\nfunction onShelterDropdownChange(shelterIdStr) {\n  if (!shelterIdStr) {\n    navigationState.selectedShelter = null;\n    return;\n  }\n  const shelterId = parseInt(shelterIdStr);\n  selectShelterById(shelterId, false);\n}\n\n/**\n * Select a Shelter by ID and optionally trigger immediate routing\n */\nwindow.selectShelterById = function(shelterId, autoRoute = false) {\n  const shelter = navigationState.allShelters.find(s => s.id === shelterId);\n  if (!shelter) return;\n\n  navigationState.selectedShelter = shelter;\n\n  // Update dropdown selection\n  const select = document.getElementById(\"selectSafeZone\");\n  if (select) select.value = shelter.id;\n\n  // Find and open marker popup\n  const marker = navigationState.shelterMarkers.find(m => m.shelterId === shelter.id);\n  if (marker) {\n    marker.openPopup();\n  }\n\n  if (autoRoute) {\n    calculateEvacuationRoute();\n  }\n};\n\n/**\n * 6. Find the Nearest Open Shelter\n */\nfunction findNearestOpenShelter(userLat, userLon) {\n  if (!navigationState.allShelters || navigationState.allShelters.length === 0) {\n    return null;\n  }\n\n  // Filter for OPEN shelters with capacity\n  const openShelters = navigationState.allShelters.filter(s => {\n    const isFull = s.status === \"FULL\" || (s.capacity && s.current_occupancy >= s.capacity);\n    return s.status !== \"CLOSED\" && !isFull;\n  });\n\n  const candidates = openShelters.length > 0 ? openShelters : navigationState.allShelters;\n\n  let nearest = null;\n  let minDistance = Infinity;\n\n  candidates.forEach(s => {\n    if (s.latitude && s.longitude) {\n      const d = haversineDistanceKm(userLat, userLon, s.latitude, s.longitude);\n      if (d < minDistance) {\n        minDistance = d;\n        nearest = s;\n      }\n    }\n  });\n\n  return nearest;\n}\n\n/**\n * Update the \"Nearest Safe Shelters\" sidebar list\n */\nfunction updateNearestSheltersList() {\n  const container = document.getElementById(\"nearestSheltersList\");\n  if (!container) return;\n\n  const userLat = navigationState.userLocation?.lat || parseFloat(document.getElementById(\"startLat\")?.value || 13.6300);\n  const userLon = navigationState.userLocation?.lon || parseFloat(document.getElementById(\"startLon\")?.value || 79.4200);\n\n  if (!navigationState.allShelters || navigationState.allShelters.length === 0) {\n    container.innerHTML = `<div class=\"text-muted p-2 text-center\">No shelters loaded.</div>`;\n    return;\n  }\n\n  // Calculate distance for each shelter and sort\n  const sorted = [...navigationState.allShelters].map(s => {\n    const dist = haversineDistanceKm(userLat, userLon, s.latitude, s.longitude);\n    const estMin = Math.max(2, Math.round((dist / 4.5) * 60));\n    const free = Math.max(0, (s.capacity || 0) - (s.current_occupancy || 0));\n    return { ...s, distanceKm: dist, estMinutes: estMin, freeSpaces: free };\n  }).sort((a, b) => a.distanceKm - b.distanceKm);\n\n  container.innerHTML = sorted.slice(0, 4).map(sz => `\n    <div class=\"p-2 mb-2 rounded d-flex align-items-center justify-content-between\" style=\"background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle);\">\n      <div style=\"flex:1; overflow:hidden; padding-right:8px;\">\n        <div class=\"fw-semibold text-truncate text-dark small\">${sz.name}</div>\n        <small class=\"text-muted\">\n          <i class=\"bi bi-clock text-primary\"></i> ~${sz.estMinutes} mins (${sz.distanceKm.toFixed(1)} km) &bull; \n          <span class=\"text-success\">${sz.freeSpaces} free</span>\n        </small>\n      </div>\n      <button class=\"btn btn-sm btn-dg-primary py-1 px-2\" style=\"font-size:0.78rem;\" onclick=\"selectShelterById(${sz.id}, true)\">\n        <i class=\"bi bi-sign-turn-right\"></i> Route\n      </button>\n    </div>\n  `).join(\"\");\n}\n\n/**\n * 7. Nearest Shelter SOS Trigger\n */\nfunction triggerNearestShelterSOS() {\n  showToast(\"SOS Triggered: Locating nearest open shelter and computing road evacuation corridor...\", \"warning\");\n\n  // Read latest coordinates\n  const lat = parseFloat(document.getElementById(\"startLat\")?.value || navigationState.userLocation?.lat || 13.6300);\n  const lon = parseFloat(document.getElementById(\"startLon\")?.value || navigationState.userLocation?.lon || 79.4200);\n\n  const nearest = findNearestOpenShelter(lat, lon);\n\n  if (!nearest) {\n    showToast(\"No open shelters currently found in database.\", \"danger\");\n    return;\n  }\n\n  selectShelterById(nearest.id, true);\n}\n\n/**\n * 8. Recalculate Route using latest coordinates\n */\nfunction recalculateRoute() {\n  showToast(\"Recalculating evacuation corridor...\", \"info\");\n  fetchUserLocation(false);\n  setTimeout(() => {\n    calculateEvacuationRoute();\n  }, 400);\n}\n\n/**\n * 9. Calculate OSRM Road Route: USER LOCATION -> SAFE SHELTER -> LEAFLET\n */\nasync function calculateEvacuationRoute() {\n  // 1. Get user latitude & longitude\n  const userLat = parseFloat(document.getElementById(\"startLat\")?.value || navigationState.userLocation?.lat || 13.6300);\n  const userLon = parseFloat(document.getElementById(\"startLon\")?.value || navigationState.userLocation?.lon || 79.4200);\n\n  navigationState.userLocation = { lat: userLat, lon: userLon };\n  renderUserMarker(userLat, userLon);\n\n  // 2. Get target safe shelter\n  let targetShelter = navigationState.selectedShelter;\n  const selectVal = document.getElementById(\"selectSafeZone\")?.value;\n\n  if (selectVal) {\n    targetShelter = navigationState.allShelters.find(s => s.id === parseInt(selectVal));\n    navigationState.selectedShelter = targetShelter;\n  }\n\n  // If no shelter selected, auto-select nearest open shelter\n  if (!targetShelter) {\n    targetShelter = findNearestOpenShelter(userLat, userLon);\n    if (!targetShelter) {\n      showToast(\"Please choose or register an open shelter first.\", \"warning\");\n      return;\n    }\n    navigationState.selectedShelter = targetShelter;\n    const select = document.getElementById(\"selectSafeZone\");\n    if (select) select.value = targetShelter.id;\n  }\n\n  showToast(`Calculating road evacuation corridor to ${targetShelter.name}...`, \"info\");\n\n  // 3. Make OSRM API Request\n  // IMPORTANT: OSRM uses longitude,latitude NOT latitude,longitude!\n  const originLng = userLon.toFixed(6);\n  const originLat = userLat.toFixed(6);\n  const destLng = Number(targetShelter.longitude).toFixed(6);\n  const destLat = Number(targetShelter.latitude).toFixed(6);\n\n  const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${originLng},${originLat};${destLng},${destLat}?overview=full&geometries=geojson&steps=true`;\n\n  try {\n    const response = await fetch(osrmUrl, {\n      method: \"GET\",\n      headers: {\n        \"Accept\": \"application/json\"\n      }\n    });\n\n    if (!response.ok) {\n      throw new Error(`OSRM routing service responded with status ${response.status}`);\n    }\n\n    const data = await response.json();\n\n    if (data.code !== \"Ok\" || !data.routes || data.routes.length === 0) {\n      throw new Error(\"No road route found between selected points.\");\n    }\n\n    const route = data.routes[0];\n    navigationState.route = route;\n\n    // 4. Connect OSRM to Leaflet Map\n    renderOSRMRouteOnMap(route, targetShelter);\n\n    // 5. Display Route Information & Turn-by-Turn Directions\n    renderRouteDetails(route, targetShelter, userLat, userLon);\n\n    showToast(`Evacuation route successfully calculated: ${(route.distance / 1000).toFixed(1)} km (~${Math.max(1, Math.round(route.duration / 60))} mins)`, \"success\");\n\n  } catch (error) {\n    console.error(\"OSRM Routing failed:\", error);\n    showToast(`OSRM routing service notice: ${error.message}. Connecting backup corridor...`, \"warning\");\n    \n    // Graceful fallback to backend route calculator if OSRM is unreachable\n    fallbackBackendRoute(userLat, userLon, targetShelter);\n  }\n}\n\n/**\n * 10. Draw OSRM Road Route Geometry on Leaflet Map\n */\nfunction renderOSRMRouteOnMap(route, targetShelter) {\n  if (!navMap) return;\n\n  // Remove existing route layer\n  if (navigationState.routeLayer) {\n    navMap.removeLayer(navigationState.routeLayer);\n    navigationState.routeLayer = null;\n  }\n\n  // Draw real road geometry from OSRM GeoJSON\n  navigationState.routeLayer = L.geoJSON(route.geometry, {\n    style: {\n      color: \"#2563eb\",\n      weight: 6,\n      opacity: 0.9,\n      lineCap: \"round\",\n      lineJoin: \"round\"\n    }\n  }).addTo(navMap);\n\n  // Zoom map to fit the complete road route perfectly\n  navMap.fitBounds(navigationState.routeLayer.getBounds(), {\n    padding: [45, 45]\n  });\n}\n\n/**\n * 11. Render Route Information & Turn-by-Turn Guidance\n */\nfunction renderRouteDetails(route, targetShelter, userLat, userLon) {\n  const panel = document.getElementById(\"directionsPanel\");\n  if (!panel) return;\n\n  const distanceKm = (route.distance / 1000).toFixed(1);\n  const durationMin = Math.max(1, Math.round(route.duration / 60));\n  const steps = route.legs?.[0]?.steps || [];\n\n  // Generate real turn-by-turn guidance from OSRM steps\n  const stepsHtml = steps.length > 0 ? steps.map((step, idx) => {\n    const maneuver = step.maneuver || {};\n    const type = maneuver.type || \"continue\";\n    const modifier = maneuver.modifier || \"\";\n    const roadName = step.name ? `onto <strong>${step.name}</strong>` : (step.ref || \"road\");\n    const distMeters = Math.round(step.distance);\n\n    let icon = \"bi-arrow-up\";\n    let instruction = \"\";\n\n    if (type === \"depart\") {\n      icon = \"bi-geo-alt-fill text-primary\";\n      instruction = `Depart heading ${modifier || 'forward'} ${roadName}`;\n    } else if (type === \"arrive\") {\n      icon = \"bi-shield-check text-success\";\n      instruction = `Arrive at <strong>${targetShelter.name}</strong>`;\n    } else if (type.includes(\"turn\") || modifier.includes(\"left\") || modifier.includes(\"right\")) {\n      if (modifier.includes(\"left\")) icon = \"bi-arrow-90deg-left text-info\";\n      else if (modifier.includes(\"right\")) icon = \"bi-arrow-90deg-right text-info\";\n      instruction = `Turn ${modifier || ''} ${roadName}`;\n    } else if (type === \"roundabout\") {\n      icon = \"bi-arrow-repeat text-warning\";\n      instruction = `Take roundabout exit ${modifier || ''} ${roadName}`;\n    } else {\n      icon = \"bi-arrow-up text-secondary\";\n      instruction = `Continue ${modifier ? modifier + ' ' : ''}${roadName}`;\n    }\n\n    return `\n      <div class=\"p-2 mb-2 rounded d-flex align-items-start gap-3\" style=\"background: rgba(0,0,0,0.02); border-left: 3px solid #2563eb;\">\n        <span class=\"badge bg-primary font-monospace\">${idx + 1}</span>\n        <div style=\"flex: 1;\">\n          <div class=\"small fw-semibold text-dark\">\n            <i class=\"bi ${icon} me-1\"></i> ${instruction}\n          </div>\n          <small class=\"text-muted font-monospace\">${distMeters > 0 ? `${distMeters} meters` : 'Destination'}</small>\n        </div>\n      </div>\n    `;\n  }).join(\"\") : `\n    <div class=\"p-3 text-muted text-center small\">Road corridor calculated directly to shelter.</div>\n  `;\n\n  // Render Information Card + Directions List\n  panel.innerHTML = `\n    <!-- Route Information Header -->\n    <div class=\"p-3 mb-3 rounded\" style=\"background: linear-gradient(135deg, #f0fdf4, #dcfce7); border: 1px solid #86efac;\">\n      <div class=\"d-flex align-items-center justify-content-between mb-2\">\n        <span class=\"badge bg-success font-monospace\"><i class=\"bi bi-check-circle-fill\"></i> STATUS: ROUTE CALCULATED</span>\n        <span class=\"badge bg-light text-dark border font-monospace\">EVACUATION ROUTE</span>\n      </div>\n      \n      <div class=\"row g-2 mb-2 text-dark\">\n        <div class=\"col-sm-6\">\n          <small class=\"text-muted d-block font-monospace\">FROM:</small>\n          <strong class=\"small text-truncate d-block\">Current Location (${userLat.toFixed(4)}, ${userLon.toFixed(4)})</strong>\n        </div>\n        <div class=\"col-sm-6\">\n          <small class=\"text-muted d-block font-monospace\">TO (SAFE SHELTER):</small>\n          <strong class=\"small text-truncate d-block text-success\">${targetShelter.name}</strong>\n        </div>\n      </div>\n\n      <div class=\"d-flex align-items-center justify-content-between border-top border-success border-opacity-25 pt-2\">\n        <div>\n          <span class=\"text-muted small\">Distance:</span>\n          <strong class=\"fs-5 text-dark ms-1 font-monospace\">${distanceKm} km</strong>\n        </div>\n        <div>\n          <span class=\"text-muted small\">Estimated Time:</span>\n          <strong class=\"fs-5 text-primary ms-1 font-monospace\">${durationMin} minutes</strong>\n        </div>\n      </div>\n    </div>\n\n    <!-- Turn-by-Turn Guidance -->\n    <div class=\"mb-3\">\n      <div class=\"text-uppercase small text-muted fw-bold mb-2 font-monospace d-flex justify-content-between\">\n        <span>Turn-By-Turn Evacuation Directions (${steps.length} steps)</span>\n        <span class=\"text-primary font-monospace\">${distanceKm} km</span>\n      </div>\n      <div style=\"max-height: 280px; overflow-y: auto;\">\n        ${stepsHtml}\n      </div>\n    </div>\n\n    <!-- Unity AR Launch Action -->\n    <div class=\"p-3 rounded text-center\" style=\"background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.2);\">\n      <div class=\"fw-bold text-primary mb-1\"><i class=\"bi bi-phone\"></i> Augmented Reality Ground Navigation</div>\n      <p class=\"small text-muted mb-2\">Project 3D directional arrows and safe zone beacons on mobile camera.</p>\n      <a href=\"unity/ar-viewer.html?dest=${encodeURIComponent(targetShelter.name)}&lat=${targetShelter.latitude}&lon=${targetShelter.longitude}&origin_lat=${userLat}&origin_lon=${userLon}\" class=\"btn btn-sm btn-dg-primary\">\n        <i class=\"bi bi-badge-ar-fill\"></i> Open in AR Viewport\n      </a>\n    </div>\n  `;\n}\n\n/**\n * Fallback to backend route calculator if OSRM is temporarily offline\n */\nasync function fallbackBackendRoute(userLat, userLon, targetShelter) {\n  try {\n    const payload = {\n      start_latitude: userLat,\n      start_longitude: userLon,\n      safe_zone_id: targetShelter.id,\n      avoid_disasters: true\n    };\n    const route = await ApiClient.post(\"/navigation/route\", payload);\n    \n    // Draw backend waypoints\n    if (navigationState.routeLayer) navMap.removeLayer(navigationState.routeLayer);\n    const latlngs = route.waypoints.map(w => [w.latitude, w.longitude]);\n    navigationState.routeLayer = L.polyline(latlngs, {\n      color: '#059669',\n      weight: 6,\n      opacity: 0.9\n    }).addTo(navMap);\n    navMap.fitBounds(navigationState.routeLayer.getBounds(), { padding: [40, 40] });\n\n    // Mock steps for UI\n    const mockSteps = route.waypoints.map(w => ({\n      maneuver: { type: 'continue', modifier: 'straight' },\n      name: w.instruction,\n      distance: w.distance_meters\n    }));\n\n    renderRouteDetails({\n      distance: route.distance_km * 1000,\n      duration: route.estimated_minutes * 60,\n      legs: [{ steps: mockSteps }]\n    }, targetShelter, userLat, userLon);\n\n  } catch (e) {\n    showToast(\"Route calculation failed on both OSRM and backend.\", \"danger\");\n  }\n}\n\n/**\n * Haversine formula to compute great-circle distance between two points in km\n */\nfunction haversineDistanceKm(lat1, lon1, lat2, lon2) {\n  const R = 6371; // Earth's radius in kilometers\n  const dLat = (lat2 - lat1) * Math.PI / 180;\n  const dLon = (lon2 - lon1) * Math.PI / 180;\n  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +\n            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *\n            Math.sin(dLon / 2) * Math.sin(dLon / 2);\n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n  return R * c;\n}\n"
          },
