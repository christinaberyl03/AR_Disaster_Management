          "content": {
            "size": 5832,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Emergency Evacuation Navigator - DisasterGuard</title>\n  <!-- Bootstrap 5 CSS -->\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <!-- Bootstrap Icons -->\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">\n  <!-- Leaflet CSS -->\n  <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" />\n  <!-- Custom Styles -->\n  <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n  <link rel=\"stylesheet\" href=\"assets/css/dashboard.css\">\n  <style>\n    #navMap {\n      width: 100%;\n      height: 500px;\n      border-radius: var(--radius-md);\n      border: 1px solid var(--border-subtle);\n      position: relative;\n      z-index: 1;\n    }\n    .leaflet-control-zoom {\n      z-index: 999 !important;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <!-- Sidebar -->\n    <div id=\"sidebar-container\"></div>\n\n    <main class=\"app-main\">\n      <!-- Topbar -->\n      <div id=\"topbar-container\"></div>\n\n      <div class=\"page-content\">\n        <div class=\"page-header mb-4\">\n          <div>\n            <h1 class=\"page-title\">Hazard-Aware Evacuation Navigator</h1>\n            <p class=\"page-subtitle\">Computes turn-by-turn escape corridors avoiding active floods, fires, and road collapses</p>\n          </div>\n          <div>\n            <button class=\"btn btn-dg-danger\" id=\"btnEmergencyNearest\">\n              <i class=\"bi bi-lightning-charge-fill\"></i> Nearest Shelter SOS\n            </button>\n          </div>\n        </div>\n\n        <div class=\"row g-4\">\n          <!-- Left: Route Planning Form & Quick Nearest Shelters -->\n          <div class=\"col-lg-4\">\n            <div class=\"dg-card mb-4\">\n              <div class=\"dg-card-header\">\n                <div class=\"dg-card-title\">\n                  <i class=\"bi bi-geo-alt-fill text-primary\"></i>\n                  <span>Evacuation Waypoints</span>\n                </div>\n              </div>\n\n              <button class=\"btn btn-sm btn-dg-outline w-100 mb-3\" id=\"btnUseCurrentLocation\" type=\"button\">\n                <i class=\"bi bi-crosshair\"></i> Use My Current Location\n              </button>\n\n              <div class=\"row g-2 mb-3\">\n                <div class=\"col-6\">\n                  <label class=\"form-label small text-muted\">Departure Latitude</label>\n                  <input type=\"number\" step=\"0.000001\" id=\"startLat\" class=\"form-control\" value=\"13.6300\" />\n                </div>\n                <div class=\"col-6\">\n                  <label class=\"form-label small text-muted\">Departure Longitude</label>\n                  <input type=\"number\" step=\"0.000001\" id=\"startLon\" class=\"form-control\" value=\"79.4200\" />\n                </div>\n              </div>\n\n              <div class=\"mb-3\">\n                <label class=\"form-label small text-muted\">Target Safe Zone Shelter</label>\n                <select id=\"selectSafeZone\" class=\"form-select\">\n                  <option value=\"\">-- Auto-Select Nearest Open Shelter --</option>\n                </select>\n              </div>\n\n              <div class=\"d-flex gap-2\">\n                <button class=\"btn btn-dg-primary flex-grow-1 py-2\" id=\"btnCalculateRoute\">\n                  <i class=\"bi bi-sign-turn-right-fill\"></i> Calculate Safe Corridor\n                </button>\n                <button class=\"btn btn-dg-outline py-2 px-3\" id=\"btnRecalculateRoute\" title=\"Recalculate Route with latest position\">\n                  <i class=\"bi bi-arrow-clockwise\"></i> Recalculate\n                </button>\n              </div>\n            </div>\n\n            <!-- Nearest Shelters Panel -->\n            <div class=\"dg-card\">\n              <div class=\"dg-card-header\">\n                <div class=\"dg-card-title\">\n                  <i class=\"bi bi-shield-check text-success\"></i>\n                  <span>Nearest Safe Shelters</span>\n                </div>\n              </div>\n              <div id=\"nearestSheltersList\">\n                <div class=\"text-muted p-2 text-center\">Locating nearby shelters...</div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right: Map View & Directions Drawer -->\n          <div class=\"col-lg-8\">\n            <div class=\"dg-card mb-4\">\n              <div class=\"dg-card-header\">\n                <div class=\"dg-card-title\">\n                  <i class=\"bi bi-compass-fill text-info\"></i>\n                  <span>Live Evacuation Route Map</span>\n                </div>\n              </div>\n              <div id=\"navMap\"></div>\n            </div>\n\n            <div class=\"dg-card\">\n              <div class=\"dg-card-header\">\n                <div class=\"dg-card-title\">\n                  <i class=\"bi bi-list-ol text-warning\"></i>\n                  <span>Evacuation Guidance & Directions</span>\n                </div>\n              </div>\n              <div id=\"directionsPanel\">\n                <div class=\"text-center p-4 text-muted\">\n                  <i class=\"bi bi-cursor-fill display-5 d-block mb-2\"></i>\n                  Click \"Calculate Safe Corridor\" or \"Nearest Shelter SOS\" to generate navigation.\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Dependencies -->\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n  <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n  <!-- App Scripts -->\n  <script src=\"assets/js/api.js\"></script>\n  <script src=\"assets/js/auth.js\"></script>\n  <script src=\"assets/js/common.js\"></script>\n  <script src=\"assets/js/navigation.js\"></script>\n</body>\n</html>\n"
          },
