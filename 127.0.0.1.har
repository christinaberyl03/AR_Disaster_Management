          "content": {
            "size": 8184,
            "mimeType": "text/javascript",
            "text": "/**\n * DisasterGuard Common UI Layout & Navigation Injector\n * Light Mode Primary with Dynamic Theme Switcher\n */\n\n// Initialize Theme immediately before render\n(function() {\n  const savedTheme = localStorage.getItem(\"dg_theme\") || \"light\";\n  document.documentElement.setAttribute(\"data-theme\", savedTheme);\n})();\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  renderSidebar();\n  renderTopbar();\n  initEmergencyAlertTicker();\n});\n\nfunction toggleTheme() {\n  const current = document.documentElement.getAttribute(\"data-theme\") || \"light\";\n  const next = current === \"light\" ? \"dark\" : \"light\";\n  document.documentElement.setAttribute(\"data-theme\", next);\n  localStorage.setItem(\"dg_theme\", next);\n\n  const btn = document.getElementById(\"themeToggleBtn\");\n  if (btn) {\n    btn.innerHTML = `<i class=\"bi ${next === 'dark' ? 'bi-sun-fill text-warning' : 'bi-moon-stars text-primary'}\"></i> <span class=\"d-none d-xl-inline\">${next === 'dark' ? 'Light Mode' : 'Dark Mode'}</span>`;\n  }\n\n  // Notify components (charts, maps) of theme alteration\n  window.dispatchEvent(new CustomEvent(\"dg-theme-change\", { detail: { theme: next } }));\n}\n\nfunction renderSidebar() {\n  const container = document.getElementById(\"sidebar-container\");\n  if (!container) return;\n\n  const currentPath = window.location.pathname.split(\"/\").pop() || \"index.html\";\n  const user = Auth.getUser();\n  const isAdmin = Auth.isAdmin();\n\n  container.innerHTML = `\n    <aside class=\"app-sidebar\" id=\"appSidebar\">\n      <div class=\"sidebar-brand\">\n        <div class=\"brand-icon\">\n          <i class=\"bi bi-shield-shaded\"></i>\n        </div>\n        <div class=\"brand-text\">\n          <h1>DisasterGuard</h1>\n          <span>AR Command Center</span>\n        </div>\n      </div>\n\n      <nav class=\"sidebar-nav\">\n        <div class=\"nav-section-title\">Core Operations</div>\n        <a href=\"dashboard.html\" class=\"nav-item-link ${currentPath === 'dashboard.html' ? 'active' : ''}\">\n          <i class=\"bi bi-speedometer2\"></i>\n          <span>Command Center</span>\n        </a>\n        <a href=\"map.html\" class=\"nav-item-link ${currentPath === 'map.html' ? 'active' : ''}\">\n          <i class=\"bi bi-geo-alt-fill\"></i>\n          <span>Live Tactical Map</span>\n        </a>\n        <a href=\"navigation.html\" class=\"nav-item-link ${currentPath === 'navigation.html' ? 'active' : ''}\">\n          <i class=\"bi bi-sign-turn-right-fill\"></i>\n          <span>Evacuation Navigator</span>\n        </a>\n        <a href=\"ai_risk.html\" class=\"nav-item-link ${currentPath === 'ai_risk.html' ? 'active' : ''}\">\n          <i class=\"bi bi-cpu-fill\"></i>\n          <span>AI Risk Engine</span>\n        </a>\n\n        <div class=\"nav-section-title\">Emergency Resources</div>\n        <a href=\"alerts.html\" class=\"nav-item-link ${currentPath === 'alerts.html' ? 'active' : ''}\">\n          <i class=\"bi bi-broadcast\"></i>\n          <span>Broadcast Alerts</span>\n        </a>\n        <a href=\"reports.html\" class=\"nav-item-link ${currentPath === 'reports.html' ? 'active' : ''}\">\n          <i class=\"bi bi-exclamation-diamond-fill\"></i>\n          <span>Incident Reports</span>\n        </a>\n        <a href=\"safe_zones.html\" class=\"nav-item-link ${currentPath === 'safe_zones.html' ? 'active' : ''}\">\n          <i class=\"bi bi-shield-check\"></i>\n          <span>Safe Zones & Shelters</span>\n        </a>\n        <a href=\"services.html\" class=\"nav-item-link ${currentPath === 'services.html' ? 'active' : ''}\">\n          <i class=\"bi bi-hospital-fill\"></i>\n          <span>Emergency Services</span>\n        </a>\n\n        ${isAdmin ? `\n          <div class=\"nav-section-title text-danger\">Administration</div>\n          <a href=\"admin.html\" class=\"nav-item-link text-warning ${currentPath === 'admin.html' ? 'active' : ''}\">\n            <i class=\"bi bi-terminal-fill\"></i>\n            <span>Admin Operations</span>\n          </a>\n        ` : ''}\n      </nav>\n\n      <div class=\"sidebar-footer\">\n        ${user ? `\n          <div class=\"user-profile-chip dropdown\">\n            <div class=\"user-avatar\" data-bs-toggle=\"dropdown\" aria-expanded=\"false\">\n              ${user.name ? user.name.charAt(0).toUpperCase() : 'U'}\n            </div>\n            <div style=\"flex: 1; overflow: hidden;\" data-bs-toggle=\"dropdown\">\n              <div style=\"font-weight: 600; font-size: 0.88rem; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;\">\n                ${user.name || 'Civilian'}\n              </div>\n              <div style=\"font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);\">\n                ${user.role}\n              </div>\n            </div>\n            <button class=\"btn btn-sm btn-link text-muted p-0\" onclick=\"Auth.logout()\" title=\"Logout\">\n              <i class=\"bi bi-box-arrow-right fs-5\"></i>\n            </button>\n          </div>\n        ` : `\n          <div class=\"d-grid gap-2\">\n            <a href=\"login.html\" class=\"btn btn-sm btn-dg-outline justify-content-center\">\n              <i class=\"bi bi-box-arrow-in-right\"></i> Sign In\n            </a>\n          </div>\n        `}\n      </div>\n    </aside>\n  `;\n}\n\nfunction renderTopbar() {\n  const container = document.getElementById(\"topbar-container\");\n  if (!container) return;\n\n  const currentTheme = document.documentElement.getAttribute(\"data-theme\") || \"light\";\n\n  container.innerHTML = `\n    <header class=\"app-topbar\">\n      <div class=\"d-flex align-items-center gap-3\">\n        <button class=\"btn btn-link text-secondary d-lg-none p-0 fs-4\" id=\"sidebarToggleBtn\">\n          <i class=\"bi bi-list\"></i>\n        </button>\n        <div class=\"badge-status badge-safe d-none d-sm-inline-flex\">\n          <span class=\"pulse-dot safe\"></span>\n          <span>SYSTEM ONLINE</span>\n        </div>\n      </div>\n\n      <!-- Live Emergency Ticker -->\n      <div class=\"emergency-ticker\" id=\"liveTickerBar\">\n        <span class=\"ticker-label\">ALERT</span>\n        <span class=\"ticker-content\" id=\"tickerText\">Monitoring active meteorological radar and incident telemetry...</span>\n      </div>\n\n      <!-- Right Actions -->\n      <div class=\"d-flex align-items-center gap-2\">\n        <!-- Theme Toggle Button -->\n        <button class=\"btn btn-sm btn-dg-outline py-1 px-3 d-flex align-items-center gap-2\" id=\"themeToggleBtn\" onclick=\"toggleTheme()\" title=\"Toggle Light / Dark Mode\">\n          <i class=\"bi ${currentTheme === 'dark' ? 'bi-sun-fill text-warning' : 'bi-moon-stars text-primary'}\"></i>\n          <span class=\"d-none d-xl-inline\">${currentTheme === 'dark' ? 'Light Mode' : 'Dark Mode'}</span>\n        </button>\n\n        <a href=\"navigation.html?action=emergency\" class=\"btn btn-sm btn-dg-danger py-1 px-3\" title=\"Immediate safe route to closest open shelter\">\n          <i class=\"bi bi-lightning-charge-fill\"></i>\n          <span class=\"d-none d-md-inline\">EMERGENCY EVACUATE</span>\n        </a>\n        <a href=\"reports.html\" class=\"btn btn-sm btn-dg-outline py-1 px-3 d-none d-sm-inline-flex\">\n          <i class=\"bi bi-megaphone-fill\"></i> Report Hazard\n        </a>\n      </div>\n    </header>\n  `;\n\n  // Mobile sidebar toggle\n  const toggleBtn = document.getElementById(\"sidebarToggleBtn\");\n  if (toggleBtn) {\n    toggleBtn.addEventListener(\"click\", () => {\n      const sidebar = document.getElementById(\"appSidebar\");\n      if (sidebar) sidebar.classList.toggle(\"show\");\n    });\n  }\n}\n\nasync function initEmergencyAlertTicker() {\n  const tickerText = document.getElementById(\"tickerText\");\n  if (!tickerText) return;\n\n  try {\n    const alerts = await ApiClient.get(\"/alerts\", { status: \"ACTIVE\" });\n    if (alerts && alerts.length > 0) {\n      let idx = 0;\n      const updateTicker = () => {\n        const item = alerts[idx];\n        tickerText.innerHTML = `<strong>[${item.severity}] ${item.title}:</strong> ${item.message}`;\n        idx = (idx + 1) % alerts.length;\n      };\n      updateTicker();\n      if (alerts.length > 1) {\n        setInterval(updateTicker, 7000);\n      }\n    } else {\n      tickerText.innerText = \"No critical emergency evacuation orders at this time. Normal vigilance advised.\";\n    }\n  } catch (e) {\n    tickerText.innerText = \"Emergency telemetry network connected. Normal vigilance advised.\";\n  }\n}\n"
          },
