        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "http/1.0",
          "headers": [
            {
              "name": "Content-Length",
              "value": "27021"
            },
            {
              "name": "Date",
              "value": "Sat, 17 Oct 2026 06:07:24 GMT"
            },
            {
              "name": "Content-type",
              "value": "text/javascript"
            },
            {
              "name": "Last-Modified",
              "value": "Thu, 24 Sep 2026 04:03:15 GMT"
            },
            {
              "name": "Server",
              "value": "SimpleHTTP/0.6 Python/3.14.4"
