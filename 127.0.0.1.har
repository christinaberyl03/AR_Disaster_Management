          "content": {
            "size": 12260,
            "mimeType": "text/css",
            "text": "/* ==========================================================================\n   DisasterGuard - Command Center & AR Navigation Design System\n   Modern High-Contrast Light Mode (Default) with Dual Theme Architecture\n   ========================================================================== */\n\n@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap');\n\n:root, [data-theme=\"light\"] {\n  /* Core Light Theme Color Tokens */\n  --bg-primary: #f8fafc;\n  --bg-surface: #ffffff;\n  --bg-surface-elevated: #ffffff;\n  --bg-card: #ffffff;\n  --bg-card-hover: #ffffff;\n  --bg-sidebar: #ffffff;\n  --bg-topbar: rgba(255, 255, 255, 0.94);\n  \n  --border-subtle: #e2e8f0;\n  --border-strong: #cbd5e1;\n  --border-focus: #2563eb;\n  --border-glow: rgba(37, 99, 235, 0.2);\n\n  --text-primary: #0f172a;\n  --text-secondary: #475569;\n  --text-muted: #64748b;\n\n  /* Tactical Hazard Palette for Light Backgrounds */\n  --critical-red: #dc2626;\n  --critical-bg: #fee2e2;\n  --critical-border: #fca5a5;\n  --critical-glow: rgba(220, 38, 38, 0.2);\n\n  --warning-amber: #d97706;\n  --warning-bg: #fef3c7;\n  --warning-border: #fde68a;\n  --warning-glow: rgba(217, 119, 6, 0.2);\n\n  --safe-emerald: #059669;\n  --safe-bg: #d1fae5;\n  --safe-border: #6ee7b7;\n  --safe-glow: rgba(5, 150, 105, 0.2);\n\n  --info-blue: #2563eb;\n  --info-bg: #dbeafe;\n  --info-border: #93c5fd;\n  --info-glow: rgba(37, 99, 235, 0.2);\n\n  --purple-accent: #7c3aed;\n\n  /* Shadows */\n  --card-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);\n  --card-shadow-hover: 0 10px 25px -4px rgba(37, 99, 235, 0.12), 0 4px 10px -2px rgba(15, 23, 42, 0.05);\n\n  /* Typography */\n  --font-heading: 'Outfit', sans-serif;\n  --font-body: 'Inter', sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n\n  /* Layout */\n  --sidebar-width: 270px;\n  --topbar-height: 70px;\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 18px;\n  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n/* Dark Theme Overrides */\n[data-theme=\"dark\"] {\n  --bg-primary: #070b14;\n  --bg-surface: #0e1626;\n  --bg-surface-elevated: #152238;\n  --bg-card: rgba(16, 26, 46, 0.85);\n  --bg-card-hover: rgba(23, 37, 66, 0.95);\n  --bg-sidebar: #090e1a;\n  --bg-topbar: rgba(9, 14, 26, 0.88);\n\n  --border-subtle: rgba(255, 255, 255, 0.08);\n  --border-strong: rgba(255, 255, 255, 0.18);\n  --border-focus: #3b82f6;\n  --border-glow: rgba(59, 130, 246, 0.35);\n\n  --text-primary: #f8fafc;\n  --text-secondary: #94a3b8;\n  --text-muted: #64748b;\n\n  --critical-red: #ef4444;\n  --critical-bg: rgba(239, 68, 68, 0.15);\n  --critical-border: rgba(239, 68, 68, 0.4);\n  --critical-glow: rgba(239, 68, 68, 0.4);\n\n  --warning-amber: #f59e0b;\n  --warning-bg: rgba(245, 158, 11, 0.15);\n  --warning-border: rgba(245, 158, 11, 0.4);\n  --warning-glow: rgba(245, 158, 11, 0.35);\n\n  --safe-emerald: #10b981;\n  --safe-bg: rgba(16, 185, 129, 0.15);\n  --safe-border: rgba(16, 185, 129, 0.4);\n  --safe-glow: rgba(16, 185, 129, 0.35);\n\n  --info-blue: #3b82f6;\n  --info-bg: rgba(59, 130, 246, 0.15);\n  --info-border: rgba(59, 130, 246, 0.4);\n  --info-glow: rgba(59, 130, 246, 0.35);\n\n  --purple-accent: #8b5cf6;\n\n  --card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.35);\n  --card-shadow-hover: 0 10px 30px -10px rgba(0, 0, 0, 0.55);\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-body);\n  background-color: var(--bg-primary);\n  color: var(--text-primary);\n  line-height: 1.6;\n  overflow-x: hidden;\n  min-height: 100vh;\n  transition: background-color var(--transition-smooth), color var(--transition-smooth);\n}\n\n/* Background Micro-Grid */\nbody::before {\n  content: \"\";\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100vw;\n  height: 100vh;\n  background: \n    radial-gradient(circle at 15% 15%, rgba(37, 99, 235, 0.04) 0%, transparent 40%),\n    radial-gradient(circle at 85% 85%, rgba(220, 38, 38, 0.03) 0%, transparent 40%),\n    linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);\n  background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;\n  pointer-events: none;\n  z-index: -1;\n}\n\n[data-theme=\"dark\"] body::before {\n  background: \n    radial-gradient(circle at 15% 15%, rgba(59, 130, 246, 0.08) 0%, transparent 40%),\n    radial-gradient(circle at 85% 85%, rgba(239, 68, 68, 0.05) 0%, transparent 40%),\n    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);\n}\n\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--font-heading);\n  font-weight: 700;\n  color: var(--text-primary);\n  letter-spacing: -0.02em;\n}\n\na {\n  color: var(--info-blue);\n  text-decoration: none;\n  transition: color var(--transition-fast);\n}\n\na:hover {\n  color: #1d4ed8;\n}\n\n[data-theme=\"dark\"] a:hover {\n  color: #60a5fa;\n}\n\n/* Glassmorphic Panel Cards */\n.dg-card {\n  background: var(--bg-card);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  padding: 1.5rem;\n  box-shadow: var(--card-shadow);\n  transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);\n  position: relative;\n  overflow: hidden;\n}\n\n.dg-card:hover {\n  border-color: rgba(37, 99, 235, 0.35);\n  box-shadow: var(--card-shadow-hover);\n}\n\n.dg-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 1.25rem;\n  padding-bottom: 0.75rem;\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.dg-card-title {\n  font-size: 1.15rem;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n}\n\n/* Tactical Status Badges */\n.badge-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.45rem;\n  padding: 0.35rem 0.75rem;\n  border-radius: 9999px;\n  font-size: 0.78rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  font-family: var(--font-mono);\n}\n\n.badge-critical {\n  background: var(--critical-bg);\n  color: var(--critical-red);\n  border: 1px solid var(--critical-border);\n}\n\n.badge-warning {\n  background: var(--warning-bg);\n  color: var(--warning-amber);\n  border: 1px solid var(--warning-border);\n}\n\n.badge-safe {\n  background: var(--safe-bg);\n  color: var(--safe-emerald);\n  border: 1px solid var(--safe-border);\n}\n\n.badge-info {\n  background: var(--info-bg);\n  color: var(--info-blue);\n  border: 1px solid var(--info-border);\n}\n\n/* Pulsing Status Dot */\n.pulse-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  display: inline-block;\n}\n\n.pulse-dot.critical {\n  background: var(--critical-red);\n  box-shadow: 0 0 10px var(--critical-red);\n  animation: pulseCritical 1.5s infinite;\n}\n\n.pulse-dot.safe {\n  background: var(--safe-emerald);\n  box-shadow: 0 0 8px var(--safe-emerald);\n  animation: pulseSafe 2s infinite;\n}\n\n.pulse-dot.warning {\n  background: var(--warning-amber);\n  box-shadow: 0 0 8px var(--warning-amber);\n}\n\n@keyframes pulseCritical {\n  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }\n  70% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(220, 38, 38, 0); }\n  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }\n}\n\n@keyframes pulseSafe {\n  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7); }\n  70% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(5, 150, 105, 0); }\n  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }\n}\n\n/* Buttons */\n.btn-dg-primary {\n  background: linear-gradient(135deg, #2563eb, #1d4ed8);\n  color: white !important;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  padding: 0.65rem 1.4rem;\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  transition: all var(--transition-fast);\n  cursor: pointer;\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);\n}\n\n.btn-dg-primary:hover {\n  background: linear-gradient(135deg, #3b82f6, #2563eb);\n  transform: translateY(-1px);\n  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);\n  color: white !important;\n}\n\n.btn-dg-danger {\n  background: linear-gradient(135deg, #dc2626, #b91c1c);\n  color: white !important;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  padding: 0.65rem 1.4rem;\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  transition: all var(--transition-fast);\n  cursor: pointer;\n  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);\n}\n\n.btn-dg-danger:hover {\n  background: linear-gradient(135deg, #ef4444, #dc2626);\n  transform: translateY(-1px);\n  box-shadow: 0 6px 18px rgba(220, 38, 38, 0.35);\n  color: white !important;\n}\n\n.btn-dg-outline {\n  background: var(--bg-surface);\n  color: var(--text-primary);\n  border: 1px solid var(--border-strong);\n  padding: 0.65rem 1.25rem;\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  transition: all var(--transition-fast);\n  cursor: pointer;\n}\n\n.btn-dg-outline:hover {\n  background: #f1f5f9;\n  border-color: #94a3b8;\n  color: #0f172a;\n}\n\n[data-theme=\"dark\"] .btn-dg-outline {\n  background: rgba(255, 255, 255, 0.05);\n  border-color: var(--border-subtle);\n  color: var(--text-primary);\n}\n\n[data-theme=\"dark\"] .btn-dg-outline:hover {\n  background: rgba(255, 255, 255, 0.12);\n  color: white;\n}\n\n/* Form Controls */\n.dg-input, .form-control, .form-select {\n  background-color: var(--bg-surface) !important;\n  border: 1px solid var(--border-strong) !important;\n  color: var(--text-primary) !important;\n  border-radius: var(--radius-sm) !important;\n  padding: 0.65rem 1rem !important;\n  font-family: var(--font-body);\n  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n}\n\n.dg-input:focus, .form-control:focus, .form-select:focus {\n  border-color: var(--border-focus) !important;\n  box-shadow: 0 0 0 3px var(--border-glow) !important;\n  outline: none;\n}\n\n/* Tables Theme Adaptation */\n.table, .table-dark, .table-custom {\n  --bs-table-bg: transparent !important;\n  --bs-table-color: var(--text-primary) !important;\n  --bs-table-border-color: var(--border-subtle) !important;\n  --bs-table-hover-bg: rgba(0, 0, 0, 0.025) !important;\n  color: var(--text-primary) !important;\n}\n\n[data-theme=\"dark\"] .table-dark, [data-theme=\"dark\"] .table-custom {\n  --bs-table-hover-bg: rgba(255, 255, 255, 0.04) !important;\n}\n\n.table th {\n  border-bottom: 2px solid var(--border-subtle) !important;\n  color: var(--text-secondary);\n}\n\n/* Toast Notifications Container */\n#toast-container {\n  position: fixed;\n  bottom: 24px;\n  right: 24px;\n  z-index: 99999;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.dg-toast {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  padding: 1rem 1.25rem;\n  color: var(--text-primary);\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  min-width: 320px;\n  animation: slideInRight 0.3s forwards;\n}\n\n.dg-toast.success { border-left: 4px solid var(--safe-emerald); }\n.dg-toast.danger { border-left: 4px solid var(--critical-red); }\n.dg-toast.warning { border-left: 4px solid var(--warning-amber); }\n.dg-toast.info { border-left: 4px solid var(--info-blue); }\n\n@keyframes slideInRight {\n  from { transform: translateX(100%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n\n/* Modals */\n.modal-content {\n  background-color: var(--bg-surface-elevated);\n  border: 1px solid var(--border-subtle);\n  color: var(--text-primary);\n  border-radius: var(--radius-md);\n  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);\n}\n\n.modal-header, .modal-footer {\n  border-color: var(--border-subtle);\n}\n\n/* Leaflet Popups */\n.leaflet-popup-content-wrapper {\n  background: var(--bg-surface) !important;\n  color: var(--text-primary) !important;\n  border: 1px solid var(--border-subtle) !important;\n  border-radius: var(--radius-sm) !important;\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;\n}\n\n.leaflet-popup-tip {\n  background: var(--bg-surface) !important;\n}\n"
          },
